rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // 사이트를 거치지 않고 직접 접근해도, 동의 기록이 있는 회원만 행복택시를 쓸 수 있게 함
    function consented() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.consentVer is string;
    }
    function shortStr(v, n) { return v is string && v.size() <= n; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // 관리자 명단: 본인이 관리자인지만 확인 가능, 등록·삭제는 콘솔에서만
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // 관리자 공개키: 누구나 읽기(암호화용), 쓰기는 관리자만
    match /config/publicKey {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['jwk', 'kid', 'alg', 'createdAt', 'by'])
        && request.resource.data.by == request.auth.uid;
    }

    // AI 서버 주소: 누구나 읽기(사이트가 연결용으로 사용), 쓰기는 관리자만, https 주소만
    match /config/modelServer {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['url', 'updatedAt', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.url is string && request.resource.data.url.size() <= 200
        && (request.resource.data.url == '' || request.resource.data.url.matches('^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$'));
    }

    // 서비스 정보(별명·마을·동의 기록): 본인만 읽고 쓰기, 관리자는 읽기
    function userShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['consentVer', 'consentAt', 'consentClientAt', 'age14', 'nick', 'village', 'createdAt', 'updatedAt', 'vaultKid'])
        && d.consentVer is string && d.age14 == true
        && shortStr(d.nick, 12) && shortStr(d.village, 20)
        && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      // 동의 일시는 서버 시각으로만 기록되고, 나중에 바꿀 수 없음(새 버전 재동의 때만 새로 기록)
      allow create: if isMe(uid) && userShape() && request.resource.data.consentAt == request.time;
      allow update: if isMe(uid) && userShape()
        && (request.resource.data.consentAt == resource.data.consentAt
            || (request.resource.data.consentAt == request.time && request.resource.data.consentVer != resource.data.consentVer));
      allow delete: if isMe(uid);
    }

    // 개인정보 금고(암호화된 이름·이메일): 본인은 쓰기·삭제만, 읽기는 관리자만
    match /vault/{uid} {
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['alg', 'iv', 'ek', 'ct', 'kid', 'v', 'updatedAt'])
        && shortStr(request.resource.data.ct, 4000) && shortStr(request.resource.data.ek, 1000);
      allow delete: if isMe(uid);
      allow read: if isAdmin();
    }

    // 행복택시 요청
    match /taxiRequests/{id} {
      allow read: if consented();
      // 새 요청: 본인 이름으로, 아직 기사 없음, 상태는 '요청'
      allow create: if consented()
        && request.resource.data.keys().hasOnly(['requester', 'nick', 'village', 'items', 'etc', 'due', 'drop', 'price', 'fee', 'status', 'driver', 'at'])
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.driver == null && request.resource.data.status == 'open'
        && shortStr(request.resource.data.nick, 12) && shortStr(request.resource.data.village, 20)
        && request.resource.data.items is list && request.resource.data.items.size() <= 20
        && shortStr(request.resource.data.etc, 60) && shortStr(request.resource.data.due, 20) && shortStr(request.resource.data.drop, 20)
        && request.resource.data.price is number && request.resource.data.fee is number
        && request.resource.data.at is number;
      allow update: if consented() && (
        // 수락: 아직 아무도 안 받은 요청을 내가 받음 (한 명만 성공)
        (resource.data.driver == null && resource.data.status == 'open'
          && changed().hasOnly(['driver', 'driverNick', 'status'])
          && request.resource.data.driver == request.auth.uid && request.resource.data.status == 'accepted'
          && shortStr(request.resource.data.driverNick, 12)
          && resource.data.requester != request.auth.uid)
        ||
        // 진행: 내가 받은 요청의 상태만 한 단계씩
        (resource.data.driver == request.auth.uid && changed().hasOnly(['status'])
          && ((resource.data.status == 'accepted' && request.resource.data.status == 'bought')
              || (resource.data.status == 'bought' && request.resource.data.status == 'done')))
      );
      // 취소·탈퇴: 요청한 본인만 삭제
      allow delete: if signedIn() && resource.data.requester == request.auth.uid;
    }

    // 등록된 가게(시설): 누구나 읽기(분석·상담에 사용), 등록·수정·삭제는 관리자만
    match /facilities/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'type', 'village', 'date', 'items', 'elderly', 'carless', 'decisions', 'lines', 'by', 'updatedAt'])
        && shortStr(request.resource.data.name, 30) && request.resource.data.name.size() > 0
        && request.resource.data.type in ['food', 'agri']
        && shortStr(request.resource.data.village, 20) && shortStr(request.resource.data.date, 10)
        && request.resource.data.items is list && request.resource.data.items.size() <= 30
        && request.resource.data.elderly is number && request.resource.data.carless is number
        && request.resource.data.decisions is map
        && request.resource.data.lines is list && request.resource.data.lines.size() <= 30
        && request.resource.data.by == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // 그 밖의 모든 데이터는 막음
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
